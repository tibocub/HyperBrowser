{
  "name": "hyperbrowser",
  "productName": "HyperBrowser",
  "version": "0.0.1",
  "private": true,
  "description": "A peer-to-peer browser: sites live with their owner and their visitors.",
  "type": "module",
  "main": "shell/main.js",
  "license": "MIT",
  "imports": {
    "fs": { "bare": "bare-fs", "default": "fs" },
    "path": { "bare": "bare-path", "default": "path" },
    "os": { "bare": "bare-os", "default": "os" },
    "process": { "bare": "bare-process", "default": "process" },
    "child_process": { "bare": "bare-subprocess", "default": "child_process" },
    "url": { "bare": "bare-url", "default": "url" }
  },
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "test": "node scripts/test-runner.js",
    "test:bare": "node scripts/test-runner.js --bare",
    "test:all": "npm test && npm run test:bare"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "bare-fs": "^4.8.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "framed-stream": "^1.0.1",
    "hypergraph": "file:../hypergraph",
    "pear-runtime": "^1.3.1",
    "streamx": "^2.28.1",
    "swarmfs": "file:../SwarmFS"
  },
  "devDependencies": {
    "bare": "^1.36.0",
    "bare-subprocess": "^6.2.2",
    "bare-url": "^2.5.5",
    "brittle": "^4.5.0",
    "electron": "^42.11.18"
  },
  "engines": {
    "bare": ">=1.27",
    "node": ">=22"
  }
}
