{
  "name": "hyperbrowser",
  "productName": "HyperBrowser",
  "version": "0.0.1",
  "private": true,
  "description": "A peer-to-peer browser: sites live with their owner and their visitors.",
  "type": "module",
  "main": "shell/main.js",
  "license": "MIT",
  "imports": {
    "fs": { "bare": "bare-fs", "default": "fs" },
    "path": { "bare": "bare-path", "default": "path" },
    "os": { "bare": "bare-os", "default": "os" },
    "process": { "bare": "bare-process", "default": "process" },
    "child_process": { "bare": "bare-subprocess", "default": "child_process" },
    "url": { "bare": "bare-url", "default": "url" }
  },
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "framecheck": "electron . --framecheck",
    "test": "node scripts/test-runner.js",
    "test:bare": "node scripts/test-runner.js --bare",
    "test:sandbox": "node test/sandbox.electron.js",
    "home:build": "node node_modules/hypermd/bin/hypermd.js build sites/home --out out/home",
    "home:publish": "npm run home:build && node engine/cli.js publish out/home",
    "forum:publish": "node engine/cli.js publish sites/forum --instance HyperBrowser",
    "test:all": "npm test && npm run test:bare && npm run test:sandbox",
    "build": "node scripts/build.js",
    "release": "node scripts/release.js",
    "test:update": "node scripts/update-check.js"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "bare-fs": "^4.8.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "framed-stream": "^1.0.1",
    "hypergraph": "file:../hypergraph",
    "pear-runtime": "^1.3.1",
    "streamx": "^2.28.1",
    "swarmfs": "file:../SwarmFS"
  },
  "devDependencies": {
    "bare": "^1.36.0",
    "bare-subprocess": "^6.2.2",
    "bare-url": "^2.5.5",
    "brittle": "^4.5.0",
    "electron": "^42.11.18",
    "hypermd": "file:../HyperMD"
  },
  "engines": {
    "bare": ">=1.27",
    "node": ">=22"
  }
}
