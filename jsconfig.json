{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "paths": { "hypergraph/lib/*": ["./node_modules/hypergraph/dist/types/*"] }
  },
  "include": ["engine/**/*.js", "engine/*.d.ts", "scripts/**/*.js", "scripts/**/*.mjs", "shell/updater.js", "router/process.js", "types/*.d.ts"]
}
